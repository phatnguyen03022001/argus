  "decisions": [
    {
      "id": "DEC-001",
      "kind": "ARCHITECTURE",
      "subject": "Product topology and source-of-truth boundary",
      "outcome": "Operator-local control plane; external systems retain canonical truth",
      "reversibility": "COSTLY",
      "doc_ref": "docs/DECISIONS.md#DEC-001"
    },
    {
      "id": "DEC-002",
      "kind": "DATA",
      "subject": "Truth ownership classes",
      "outcome": "Exactly four non-overlapping truth classes",
      "reversibility": "COSTLY",
      "doc_ref": "docs/DECISIONS.md#DEC-002"
    },
    {
      "id": "DEC-003",
      "kind": "DATA",
      "subject": "Identity and observation reconciliation",
      "outcome": "Prefer canonical immutable identity and preserve provenance/freshness/conflicts",
      "reversibility": "COSTLY",
      "doc_ref": "docs/DECISIONS.md#DEC-003"
    },
    {
      "id": "DEC-004",
      "kind": "DATA",
      "subject": "Argus-native durability",
      "outcome": "Storage-independent migration, backup/export, restore, validation, and cache separation",
      "reversibility": "COSTLY",
      "doc_ref": "docs/DECISIONS.md#DEC-004"
    },
    {
      "id": "DEC-005",
      "kind": "ARCHITECTURE",
      "subject": "Secret ownership",
      "outcome": "macOS Keychain owns secret values; Argus stores references only",
      "reversibility": "COSTLY",
      "doc_ref": "docs/DECISIONS.md#DEC-005"
    },
    {
      "id": "DEC-006",
      "kind": "INTERFACE",
      "subject": "Execution capability abstraction",
      "outcome": "Transport-independent semantic capabilities; availability is separate from authority",
      "reversibility": "REVERSIBLE",
      "doc_ref": "docs/DECISIONS.md#DEC-006"
    },
    {
      "id": "DEC-007",
      "kind": "ARCHITECTURE",
      "subject": "Controlled external mutation",
      "outcome": "Fail closed on identity, authority, capability, precondition, side-effect, or postcondition uncertainty",
      "reversibility": "COSTLY",
      "doc_ref": "docs/DECISIONS.md#DEC-007"
    },
    {
      "id": "DEC-008",
      "kind": "OTHER",
      "subject": "Requirement-to-product promotion",
      "outcome": "Accepted product truth is materialized and canonical in the target repository",
      "reversibility": "COSTLY",
      "doc_ref": "docs/DECISIONS.md#DEC-008"
    },
    {
      "id": "DEC-009",
